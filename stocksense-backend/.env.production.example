DATABASE_URL=postgresql+psycopg://<database-user>:<url-encoded-password>@<database-host>:5432/Oddo_Hackthon
DATABASE_URL_DOCKER=postgresql+psycopg://<database-user>:<url-encoded-password>@postgres:5432/Oddo_Hackthon
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=10
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
STOCKSENSE_SYSTEM_USER_ID=<existing-user-uuid>
STOCKSENSE_ALERT_WEBHOOK_URL=
AUTH_RATE_LIMIT=5/minute
ENVIRONMENT=production
POSTGRES_DB=Oddo_Hackthon
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<strong-production-password>